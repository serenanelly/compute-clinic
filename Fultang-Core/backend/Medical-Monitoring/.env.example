# ============================================================
# .env.example — Template des variables d'environnement
# Fultang / Medical-Monitoring
# ============================================================
# Copiez ce fichier vers .env et modifiez les valeurs selon vos besoins.
# NE JAMAIS COMMITER LE FICHIER .env DANS LE DÉPÔT.

# ------------------------------------------------------------
# Django Configuration
# ------------------------------------------------------------
DEBUG=True
SECRET_KEY=django-insecure-remplacez-ce-secret-par-une-valeur-sure-en-prod
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ------------------------------------------------------------
# PostgreSQL Superuser
# (Utilisé pour l'administration et l'initialisation du conteneur)
# ------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here

# ------------------------------------------------------------
# Application Database (Fultang App)
# (Ces valeurs sont utilisées par database/init/01_init.sh)
# ------------------------------------------------------------
FULTANG_DB_NAME=fultang_medical_monitoring
FULTANG_DB_USER=fultang_user
FULTANG_DB_PASSWORD=fultang_password_here

# ------------------------------------------------------------
# Django Connection Configuration
# (Configuration pour se connecter à la DB applicative créée)
# ------------------------------------------------------------
DB_HOST=db
DB_PORT=5432

# URL de connexion complète (format compatible django-environ)
DATABASE_URL=postgres://fultang_user:fultang_password_here@db:5432/fultang_medical_monitoring
