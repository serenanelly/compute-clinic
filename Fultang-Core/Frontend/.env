VITE_BACKEND_FULTANG_API_BASE_MEDICALSTAFF_URL=http://localhost:8080/medical
VITE_BACKEND_FULTANG_API_BASE_ACCOUNTANT_URL=http://localhost:8080/compta-financiere
VITE_API_GATEWAY_URL=http://localhost:8080
VITE_BACKEND_COMPTABILITE_MATIERE_URL=http://localhost:8080/compta-matiere

# Domaine racine de résolution de tenant par sous-domaine (doit correspondre
# à TENANT_ROOT_DOMAIN côté api-gateway). Convention de développement local
# (Cycle de vie du tenant, Phase 2) : "*.localhost" se résout automatiquement
# vers 127.0.0.1 dans les navigateurs modernes, sans entrée /etc/hosts à
# créer — utiliser "fulltang.com" pour un environnement de démo plus proche
# de la production (nécessite alors des entrées /etc/hosts manuelles).
VITE_TENANT_ROOT_DOMAIN=localhost
